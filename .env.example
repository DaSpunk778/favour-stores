# Copy this file to .env.local and fill in real values.
# On Netlify, set these under: Site configuration → Environment variables.

# Postgres connection string (Supabase). Used by lib/db.ts and config/config.js.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign the session JWT cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string
